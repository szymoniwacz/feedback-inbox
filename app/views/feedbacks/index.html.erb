<% content_for :title, "Feedback inbox" %>

<main>
  <h1>Feedback inbox</h1>

  <%= form_with url: feedbacks_path, method: :get, html: { class: "category-filter-form" } do |form| %>
    <fieldset>
      <legend>Filter by category</legend>
      <% Feedback::FILTERS.each do |filter_value| %>
        <% label = filter_value == Feedback::FILTER_ALL ? "All" : filter_value %>
        <div>
          <%= form.radio_button :filter, filter_value, checked: @filter == filter_value, id: "filter_#{filter_value.parameterize}" %>
          <%= form.label :filter, label, value: filter_value, for: "filter_#{filter_value.parameterize}" %>
        </div>
      <% end %>
      <%= form.submit "Apply filter" %>
    </fieldset>
  <% end %>

  <% if flash[:alert].present? %>
    <p class="flash-alert" role="alert"><%= flash[:alert] %></p>
  <% end %>
  <% if flash[:notice].present? %>
    <p class="flash-notice"><%= flash[:notice] %></p>
  <% end %>

  <% if @feedbacks.empty? %>
    <% if @filter == Feedback::FILTER_ALL %>
      <p>No feedback yet. <%= link_to "Submit the first item", new_feedback_path %>.</p>
    <% else %>
      <p>No feedback in the <strong><%= @filter %></strong> category. <%= link_to "Show all items", feedbacks_path %> or <%= link_to "submit feedback", new_feedback_path %>.</p>
    <% end %>
  <% else %>
    <ul class="feedback-inbox">
      <% @feedbacks.each do |feedback| %>
        <li>
          <article aria-labelledby="feedback-<%= feedback.id %>-title">
            <h2 id="feedback-<%= feedback.id %>-title"><%= feedback.title %></h2>

            <dl>
              <dt>Description</dt>
              <dd><%= feedback.description %></dd>

              <dt>Category</dt>
              <dd>
                <%= form_with model: feedback, url: feedback_path(feedback, filter: @filter), method: :patch, html: { class: "category-form" } do |form| %>
                  <%= form.label :category, "Change category", for: "feedback_#{feedback.id}_category" %>
                  <%= form.select :category, Feedback::CATEGORIES, {}, id: "feedback_#{feedback.id}_category" %>
                  <%= form.submit "Update category" %>
                <% end %>
              </dd>

              <dt>Submitted</dt>
              <dd><time datetime="<%= feedback.created_at.iso8601 %>"><%= l(feedback.created_at, format: :long) %></time></dd>
            </dl>
          </article>
        </li>
      <% end %>
    </ul>
  <% end %>

  <p>
    <%= link_to "Submit feedback", new_feedback_path %>
    <%= link_to "Home", root_path %>
  </p>
</main>
